# =============================================================================
# UA AGRO VOICE PLATFORM -- production environment for the one-host stack
#
#   cp infra/deploy/production.env.example .env
#   (fill it)  ->  make preflight  ->  infra/deploy/bootstrap.sh
#
# Every FILL_ME is required. `scripts/deploy_preflight.py` refuses to start the
# stack while one is left, and the services refuse to boot without the ones
# they need (§0 rule 4). Never commit .env. (§17)
#
# Generate what is yours to choose:
#   openssl rand -hex 32            PHONE_HASH_PEPPER, JWT_SIGNING_KEY, ADMIN_SESSION_SECRET
#   openssl rand -hex 24            TELEPHONY_WS_TOKEN, INTERNAL_API_TOKEN
#   openssl rand -hex 16            POSTGRES_PASSWORD, REDIS_PASSWORD, S3_SECRET_ACCESS_KEY
#   openssl rand -base64 32         LOCAL_DEK_BASE64 (only without a KMS)
# =============================================================================

# ---------- RUNTIME ----------
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
IMAGE_TAG=latest

# ---------- THE EDGE (TLS) ----------
# Two DNS A records pointing at this host. Caddy obtains and renews the
# certificates itself; ports 80 and 443 must be open to the world.
PANEL_HOST=FILL_ME                  # e.g. panel.uaagro.in  -- the control panel
VOICE_HOST=FILL_ME                  # e.g. voice.uaagro.in  -- the media WebSocket
ACME_EMAIL=FILL_ME                  # certificate expiry notices
# The public address of the voice worker, as the telephony provider sees it.
# https here becomes wss on the stream.
PUBLIC_BASE_URL=https://FILL_ME     # https://voice.<domain>
VOICE_WORKER_PUBLIC_URL=https://FILL_ME
API_PUBLIC_URL=https://FILL_ME      # https://panel.<domain> -- the API is not public; this is where the panel is
# The demo backend is not deployed. The panel's development links stay unset.
DEMO_PUBLIC_URL=

# ---------- IDENTITY (§2) ----------
ORG_NAME=UA Agro Solutions Private Limited
BRAND_NAME=Naveen Khushhali Kisan Sewa Kendra
HELPLINE_TOLLFREE=1800 212 7074
MISSED_CALL_NUMBER=+91 7232020335
SUPPORT_EMAIL=contact@uaagro.in
DEFAULT_TIMEZONE=Asia/Kolkata
CURRENCY=INR
USD_INR_RATE=88.0

# ---------- TELEPHONY (§2, §4.3) ----------
TELEPHONY_PROVIDER=exotel           # exotel | plivo | twilio
EXOTEL_SID=FILL_ME
EXOTEL_API_KEY=FILL_ME
EXOTEL_API_TOKEN=FILL_ME
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_APP_ID=FILL_ME               # the numeric id in the flow's URL
INBOUND_DID=FILL_ME
OUTBOUND_CLI_PROMOTIONAL=FILL_ME    # MUST be a 140-series number (§18)
OUTBOUND_CLI_TRANSACTIONAL=FILL_ME
# The provider presents this on the media WebSocket handshake:
#   wss://voice.<domain>/ws/voice?token=<TELEPHONY_WS_TOKEN>
TELEPHONY_WS_TOKEN=FILL_ME
# The provider's media IP ranges, comma-separated CIDRs. The socket accepts
# nobody else. Empty is refused in production.
TELEPHONY_IP_ALLOWLIST=FILL_ME
# Twilio, when TELEPHONY_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# ---------- SERVICE TO SERVICE ----------
# Same value on the API and the voice worker: one variable, one image.
INTERNAL_API_TOKEN=FILL_ME
VOICE_WORKER_URL=http://voice-worker:8080

# ---------- SPEECH (§5) ----------
SONIOX_API_KEY=FILL_ME
SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
BAKBAK_API_KEY=FILL_ME
BAKBAK_BASE_URL=https://hub.getraya.app/v1
BAKBAK_VOICE_HI=FILL_ME             # chosen in the bake-off (docs/VERIFICATION.md §2)
BAKBAK_VOICE_EN=
BAKBAK_VOICES=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# ---------- MODEL (§6) ----------
ANTHROPIC_API_KEY=FILL_ME
LLM_BASE_URL=https://api.anthropic.com

# ---------- WHATSAPP (§14) ----------
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=
WA_APP_SECRET=

# ---------- DATA (compose-internal addresses) ----------
POSTGRES_PASSWORD=FILL_ME
REDIS_PASSWORD=FILL_ME
# Both DSNs carry POSTGRES_PASSWORD (replace the <placeholder> with the same
# value); the app role is created by the first migration with the password
# in DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://uaagro_app:<POSTGRES_PASSWORD>@postgres:5432/uaagro
DATABASE_URL_MIGRATOR=postgresql+asyncpg://uaagro:<POSTGRES_PASSWORD>@postgres:5432/uaagro
DATABASE_POOL_SIZE=10
DATABASE_INCALL_STATEMENT_TIMEOUT_MS=120
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# Recordings and uploads. MinIO on the host by default; for real S3 set the
# AWS endpoint, S3_FORCE_PATH_STYLE=false, and remove the minio services.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=uaagro-recordings
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=FILL_ME
S3_SECRET_ACCESS_KEY=FILL_ME
S3_FORCE_PATH_STYLE=true

# ---------- CRYPTO (§17) ----------
PHONE_HASH_PEPPER=FILL_ME           # permanent: rotating it orphans every farmer row
JWT_SIGNING_KEY=FILL_ME
ADMIN_SESSION_SECRET=FILL_ME
SESSION_COOKIE_SECURE=true
# Phone numbers are encrypted with a data key. With AWS, the key lives in KMS:
KMS_KEY_ID=FILL_ME
# On a host with no KMS, keep the key in this file instead -- weaker, and said
# so at boot. Set both lines and leave KMS_KEY_ID empty:
#   ALLOW_LOCAL_DEK_IN_PRODUCTION=true
#   LOCAL_DEK_BASE64=<openssl rand -base64 32>
ALLOW_LOCAL_DEK_IN_PRODUCTION=false
LOCAL_DEK_BASE64=

# ---------- DATA SOURCES ----------
# The Data page may connect only to public addresses. If the client's MySQL
# server is on a private network reached over a VPN or peering, say so:
SOURCES_ALLOW_PRIVATE_NETWORKS=false
# Requests a minute one address may make of the API (sign-in is stricter).
API_RATE_LIMIT_PER_MINUTE=600

# ---------- COMPLIANCE (§18) ----------
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=21:00
DLT_TEMPLATE_ID=FILL_ME
DLT_ENTITY_ID=FILL_ME
MAX_ATTEMPTS_PER_CONTACT=3
MIN_HOURS_BETWEEN_ATTEMPTS=24
DATA_RETENTION_DAYS_RECORDINGS=180
DATA_RETENTION_DAYS_TRANSCRIPTS=730
OUTBOUND_QUICK_DIAL_SELF_APPROVE=false

# ---------- BUDGET GUARDS (§8) ----------
MAX_COST_PER_CALL_INR=25
DAILY_SPEND_CAP_INR=5000
MAX_CONCURRENT_CALLS=30

# ---------- OBSERVABILITY ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
