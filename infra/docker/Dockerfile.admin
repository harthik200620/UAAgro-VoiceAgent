# The Next.js control panel (§15).
#
# Standalone output, so the runtime image carries the server and the traced
# dependencies rather than the whole of node_modules. It is the difference
# between a ~150 MB image and a ~1 GB one, and the panel is deployed behind
# CloudFront where the cold-start matters.

# ---------------------------------------------------------------- deps
FROM node:22-bookworm-slim AS deps

WORKDIR /app

# Manifests first: they change far less often than the pages, so an edit to a
# screen does not reinstall the dependency tree.
COPY package.json package-lock.json ./
RUN npm ci

# ---------------------------------------------------------------- builder
FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# No build-time API_BASE_URL. §1 N6 keeps the control-plane address and every
# credential server-side, and a value baked in at build time would be a value
# that cannot differ between staging and production without a rebuild.
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---------------------------------------------------------------- runtime
FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Non-root. The panel renders staff pages and holds a session cookie; there is
# no reason for it to be able to write to its own image.
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs nextjs

# `standalone` contains the server and only the dependencies it traced. The
# static and public directories are copied separately because Next does not
# include them in the trace.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=6 \
    CMD node -e "fetch('http://127.0.0.1:3000/hi').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
