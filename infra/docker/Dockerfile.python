# Shared image for the API, voice worker, background worker and migrations.
# One image, different commands: they share the same workspace and dependency
# closure, and three near-identical Dockerfiles drift.

# ---------------------------------------------------------------- builder
FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependency layer first: manifests change far less often than source, so a
# code edit does not re-resolve the whole workspace.
COPY pyproject.toml uv.lock ./
COPY packages/domain/pyproject.toml packages/domain/
COPY packages/db/pyproject.toml packages/db/
COPY packages/evals/pyproject.toml packages/evals/
COPY apps/api/pyproject.toml apps/api/
COPY apps/voice-worker/pyproject.toml apps/voice-worker/
COPY apps/worker/pyproject.toml apps/worker/
# Every workspace member's manifest must be here or `uv sync --frozen` refuses
# the lockfile. The demo is not deployed, but it is a member.
COPY apps/demo/pyproject.toml apps/demo/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-workspace --no-dev

COPY packages/ packages/
COPY apps/ apps/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---------------------------------------------------------------- runtime
FROM python:3.12-slim-bookworm AS runtime

# libpq is not needed (asyncpg speaks the wire protocol directly); curl is not
# installed, so healthchecks use python's urllib rather than adding a tool
# whose only other use would be exfiltration.
RUN groupadd --system --gid 10001 uaagro \
 && useradd --system --uid 10001 --gid uaagro --home /app --shell /usr/sbin/nologin uaagro

WORKDIR /app

COPY --from=builder --chown=uaagro:uaagro /app /app
COPY --chown=uaagro:uaagro config/ config/

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUTF8=1 \
    UAAGRO_DEFAULTS_PATH=/app/config/defaults.yaml

USER uaagro

EXPOSE 8000 8080

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
