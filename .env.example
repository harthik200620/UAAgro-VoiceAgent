# =============================================================================
# UA AGRO VOICE PLATFORM -- environment
# Copy to .env and fill. Never commit .env. (§17)
# Values marked FILL_ME are required; the process fails loudly at startup naming
# the missing variable rather than running degraded. (§0 rule 4)
# =============================================================================

# ---------- RUNTIME ----------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                      # true in staging/production

# ---------- IDENTITY (§2) ----------
ORG_NAME=UA Agro Solutions Private Limited
BRAND_NAME=Naveen Khushhali Kisan Sewa Kendra
HELPLINE_TOLLFREE=1800 212 7074
MISSED_CALL_NUMBER=+91 7232020335
SUPPORT_EMAIL=contact@uaagro.in
DEFAULT_TIMEZONE=Asia/Kolkata
CURRENCY=INR
USD_INR_RATE=88.0

# ---------- TELEPHONY (§2, §4.3) ----------
TELEPHONY_PROVIDER=exotel           # exotel | plivo | twilio | generic_sip
EXOTEL_SID=FILL_ME
EXOTEL_API_KEY=FILL_ME
EXOTEL_API_TOKEN=FILL_ME
EXOTEL_SUBDOMAIN=api.exotel.com     # the region the account answers on
# The App Bazaar flow an answered outbound call is connected to -- the one
# holding the Voicebot applet that points at this worker. Exotel's connect API
# takes a flow address, never a stream address: a call given the stream address
# rings, connects to silence and bills.
EXOTEL_APP_ID=FILL_ME               # the numeric id in the flow's URL
INBOUND_DID=FILL_ME
OUTBOUND_CLI_PROMOTIONAL=FILL_ME    # MUST be a 140-series number (§18)
OUTBOUND_CLI_TRANSACTIONAL=FILL_ME
# Shared secret the provider presents on the media WebSocket handshake (§17).
TELEPHONY_WS_TOKEN=FILL_ME

# Twilio, when TELEPHONY_PROVIDER=twilio. Authenticated with an API key, not
# the account token: a key is scoped and revocable on its own. The account SID
# is an identifier, not a secret, but it is required -- every REST path
# contains it, and the API key alone cannot say which account it acts on.
TWILIO_ACCOUNT_SID=FILL_ME          # starts AC...
TWILIO_API_KEY_SID=FILL_ME          # starts SK...
TWILIO_API_KEY_SECRET=FILL_ME
TWILIO_FROM_NUMBER=FILL_ME          # the Twilio number, E.164
# PUBLIC_BASE_URL below must be the address Twilio can reach from the public
# internet: it is where the media stream connects. https there becomes wss on
# the stream. A localhost value works only for the simulator.

# Shared secret between the control plane and the voice worker's /internal
# endpoints (the panel's question preview, voice preview and test calls).
# Set the same value on both services. Required in production.
INTERNAL_API_TOKEN=FILL_ME
# Where the control plane reaches the voice worker.
VOICE_WORKER_URL=http://localhost:8080
# Where an operator's browser reaches the voice worker: the development call
# page the panel links to, and the page that answers a simulated outbound call.
VOICE_WORKER_PUBLIC_URL=http://127.0.0.1:8080
# Comma-separated CIDRs allowed to open /ws/voice. Empty disables the check
# (development only -- an open media WebSocket is an open door).
TELEPHONY_IP_ALLOWLIST=

# ---------- SPEECH (§5) ----------
# WHICH engine serves WHICH language is config/defaults.yaml, not this file.
# There are deliberately no STT_PRIMARY / TTS_PROVIDER variables: the routing
# table is the only thing that selects a vendor, and a second knob that looks
# like it does but is never read is worse than no knob at all.
# These are the credentials and the endpoints. Everything the helpline speaks
# today runs on Soniox + Bakbak; the two below them stay wired as fallbacks and
# still serve Odia and Punjabi, which the new pair does not fully cover.

# --- speech to text: Soniox realtime (§5.1, §5.2, §5.5) ---
# One engine for every language, with its own semantic end-of-turn, so no
# separate turn model is needed. Takes 8 kHz linear16 directly (§23-8).
SONIOX_API_KEY=FILL_ME
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket

# --- text to speech: Raya Bakbak (§5.3) ---
# Synthesises at 8 kHz directly, so the telephony leg never resamples.
BAKBAK_API_KEY=FILL_ME              # looks like raya_ABCD1234...
BAKBAK_BASE_URL=https://hub.getraya.app/v1
BAKBAK_MODEL=standard               # standard | m1 -- must match the voices below
# Voice ids are account-scoped UUIDs, so there is no sane default and an unset
# one fails loudly rather than picking a stranger's voice. After the key is in:
#     uv run python scripts/bakbak_voices.py
# lists this account's voices; §5.3 says choose over a real phone line.
BAKBAK_VOICE_HI=FILL_ME
BAKBAK_VOICE_EN=FILL_ME
# Every other language, as `mr-IN=<uuid>,ta-IN=<uuid>`. Leave empty unless the
# helpline actually answers in them.
BAKBAK_VOICES=

# --- fallbacks, and the two languages the pair above does not cover ---
# Deepgram Flux: the alternative hi/en recogniser. Optional.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-multi
# Sarvam: still recognises Odia and still speaks Odia and Punjabi. Required
# only if those languages are enabled in config/defaults.yaml.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_HI=

TTS_OUTPUT_CODEC=linear16           # keep linear16: the worker's audio bus is
                                    # linear16 and MulawSerializer converts at
                                    # the wire for Plivo/Twilio (§4.3, §23-8)
TTS_OUTPUT_SAMPLE_RATE=8000         # 8000 | 16000 | 22050 | 24000; telephony is 8000

# ---------- local models (§5.2, §9) ----------
# Downloads, not credentials -- safe to commit, and each has a default. Point
# them at a mounted volume rather than baking 1.1 GB into the worker image.
# Missing weights fail loudly with the fetch command; they never degrade
# silently. Without the embedding model, retrieval runs BM25-only and cannot
# match a Hindi question against an English document.
SMART_TURN_MODEL_PATH=models/smart-turn-v3.1.onnx
E5_MODEL_DIR=models/multilingual-e5-base

# ---------- LLM (§6) ----------
# `anthropic` talks to the Messages API directly: one fewer process on the
# request path, and §7 gives time-to-first-token 550 ms at p95 out of a
# 1,200 ms turn. `litellm` keeps §6.1's gateway in front -- one place for keys,
# spend and model swaps -- and needs the LiteLLM container running.
LLM_GATEWAY=anthropic               # anthropic | litellm
ANTHROPIC_API_KEY=FILL_ME
# Where Messages API requests go. Anthropic's own host by default; point it at
# a compatible proxy to use one. A trailing /v1 is optional -- both spellings
# of "base URL" are normalised, because getting it wrong yields /v1/v1/messages
# and a 404 that reads like a dead endpoint rather than a stray slash.
#
# NOTE: a third-party endpoint here means every prompt, every farmer
# transcript and every reply transits that operator. §17 and §1-N6 assume they
# do not leave your infrastructure -- worth a deliberate decision, not a
# default.
LLM_BASE_URL=https://api.anthropic.com
LLM_PRIMARY_MODEL=claude-haiku-4-5-20251001
LLM_FALLBACK_MODEL=claude-sonnet-5
# Only read when LLM_GATEWAY=litellm.
LLM_GATEWAY_URL=http://litellm:4000
LLM_GATEWAY_MASTER_KEY=
# Generation limits live in config/defaults.yaml (llm.temperature,
# llm.max_output_tokens) -- they are product decisions, not deploy secrets, and
# the per-turn cap is tightened again for non-dosage answers (§11.3).

# ---------- EMBEDDINGS (§2) ----------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
HF_HOME=./models

# ---------- WHATSAPP (§14) ----------
WHATSAPP_PROVIDER=meta_cloud        # meta_cloud | aisensy | gupshup
WA_PHONE_NUMBER_ID=FILL_ME
WA_BUSINESS_ACCOUNT_ID=FILL_ME
WA_ACCESS_TOKEN=FILL_ME
WA_WEBHOOK_VERIFY_TOKEN=FILL_ME
WA_APP_SECRET=FILL_ME               # verifies X-Hub-Signature-256 (§14)

# ---------- DATA ----------
DATABASE_URL=postgresql+asyncpg://uaagro_app:uaagro_dev_pw@localhost:5432/uaagro
DATABASE_URL_MIGRATOR=postgresql+asyncpg://uaagro:uaagro_dev_pw@localhost:5432/uaagro
DATABASE_POOL_SIZE=10
DATABASE_INCALL_STATEMENT_TIMEOUT_MS=120   # hard cap for in-call queries (§4.1)
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uaagro-recordings
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=FILL_ME
S3_SECRET_ACCESS_KEY=FILL_ME
S3_FORCE_PATH_STYLE=true            # required by MinIO; false on real S3
KMS_KEY_ID=FILL_ME                  # required when APP_ENV=production

# ---------- CRYPTO (§17) ----------
# Pepper for the HMAC-SHA256 phone lookup index. Rotating it orphans every
# farmer row, so treat it as permanent. 32+ random bytes, base64.
PHONE_HASH_PEPPER=FILL_ME
# Local development data-encryption key, base64, 32 bytes. In production the DEK
# is wrapped by KMS and this is ignored.
LOCAL_DEK_BASE64=FILL_ME
JWT_SIGNING_KEY=FILL_ME
SESSION_COOKIE_SECURE=false         # true everywhere except local http

# ---------- COMPLIANCE (§18) ----------
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=21:00
DLT_TEMPLATE_ID=FILL_ME
DLT_ENTITY_ID=FILL_ME
MAX_ATTEMPTS_PER_CONTACT=3
MIN_HOURS_BETWEEN_ATTEMPTS=24
DATA_RETENTION_DAYS_RECORDINGS=180
DATA_RETENTION_DAYS_TRANSCRIPTS=730

# ---------- BUDGET GUARDS (§8) ----------
MAX_COST_PER_CALL_INR=25
DAILY_SPEND_CAP_INR=5000

# ---------- OBSERVABILITY (§19) ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
PROMETHEUS_PORT=9090

# --- object storage backend ------------------------------------------
# local: recordings and uploads in STORAGE_LOCAL_DIR (development, pilots).
# s3: the bucket configured by S3_* above. Production requires s3.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.localdev/objects
# A quick dial from the panel is self-approved when true (development only).
OUTBOUND_QUICK_DIAL_SELF_APPROVE=true
